GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Optional shared key for local testing; do not use as real mobile user authentication.
APP_API_KEY=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=career_booster
DB_USER=career_booster_user
DB_PASSWORD=replace_with_database_password
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_characters
# For browser builds, set exact origins, e.g. http://localhost:7358
ALLOWED_ORIGINS=http://localhost:7358
